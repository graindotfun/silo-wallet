{
  "name": "grainpad",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/runtime-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit && node scripts/check-server-only-boundary.mjs",
    "test": "node --test tests/*.test.mjs scripts/verification/transparency.test.mjs",
    "test:contracts": "forge test --root contracts",
    "test:guards": "node scripts/verification/execution-guards.mjs",
    "test:runtime": "node scripts/verification/built-worker-smoke.mjs",
    "verify:platform": "node scripts/verify-platform.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "tx:inspect": "node scripts/inspect-transaction.mjs",
    "tx:build": "node scripts/build-unsigned.mjs",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "verify:fees": "node scripts/verify-fees.mjs",
    "test:setup": "node scripts/verification/platform-setup-guards.mjs",
    "test:signing": "node scripts/verification/post-sign-guards.mjs",
    "verify:provenance": "node scripts/verify-provenance.mjs",
    "deploy:ci": "node scripts/deploy-ci.mjs",
    "verify:live": "node scripts/verify-live-version.mjs",
    "provenance:update": "node scripts/update-provenance.mjs",
    "verify:readiness": "node scripts/check-readiness.mjs",
    "review:authority": "node scripts/review-authority.mjs",
    "metadata:export": "node scripts/export-metadata.mjs",
    "storage:backup": "node scripts/storage-backup.mjs",
    "verify:release": "node scripts/verification/release-check.mjs",
    "postinstall": "node scripts/braces-depth-guard.mjs apply",
    "verify:braces-guard": "node scripts/braces-depth-guard.mjs verify",
    "prelint": "node scripts/braces-depth-guard.mjs verify"
  },
